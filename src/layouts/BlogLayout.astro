---
import BaseLayout from "./BaseLayout.astro";

export interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---
<BaseLayout title={title} description={description}>
  <script is:inline>
    // Apply the saved text size before paint to avoid a jump.
    (function () {
      try {
        var z = parseFloat(localStorage.getItem("blog-text-scale"));
        if (z > 0) document.documentElement.style.fontSize = z * 100 + "%";
      } catch (e) {}
    })();
  </script>

  <main class="page">
    <header class="site-header">
      <a class="brand" href="/">Christopher Z. Cui</a>
      <nav>
        <a href="/blog/" class="active">blog</a>
        <a href="/official/">official</a>
        <a href="/adventure/">adventure</a>
      </nav>
    </header>

    <slot />

    <footer class="site-footer">
      <span>czcui@ucsd.edu &nbsp;·&nbsp; UC San Diego</span>
      <a class="mode-toggle" href="/">back to the threshold &rarr;</a>
    </footer>
    <p class="site-attribution">
      Site constructed with the help of <a href="https://claude.com/claude-code">Claude Code</a>.
    </p>
  </main>

  <div class="lightbox" id="lightbox" hidden>
    <button class="lightbox-close" type="button" aria-label="Close image">&times; close</button>
    <div class="lightbox-frame">
      <img alt="" />
    </div>
    <p class="lightbox-hint">click image to toggle full size &middot; esc to close</p>
  </div>

  <div class="text-zoom" role="group" aria-label="Text size">
    <button type="button" id="text-bigger" aria-label="Larger text" title="Larger text">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10" cy="10" r="6.5" /><path d="M15 15l5.5 5.5M7 10h6M10 7v6" /></svg>
    </button>
    <button type="button" id="text-smaller" aria-label="Smaller text" title="Smaller text">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10" cy="10" r="6.5" /><path d="M15 15l5.5 5.5M7 10h6" /></svg>
    </button>
  </div>

  <script>
    const STEPS = [0.85, 1, 1.15, 1.3, 1.5, 1.75];
    const KEY = "blog-text-scale";
    const bigger = document.getElementById("text-bigger") as HTMLButtonElement;
    const smaller = document.getElementById("text-smaller") as HTMLButtonElement;

    let level = STEPS.indexOf(1);
    try {
      const saved = STEPS.indexOf(parseFloat(localStorage.getItem(KEY) ?? ""));
      if (saved >= 0) level = saved;
    } catch {}

    const apply = () => {
      const z = STEPS[level];
      document.documentElement.style.fontSize = z === 1 ? "" : `${z * 100}%`;
      bigger.disabled = level === STEPS.length - 1;
      smaller.disabled = level === 0;
      try { localStorage.setItem(KEY, String(z)); } catch {}
    };
    bigger.addEventListener("click", () => { level = Math.min(level + 1, STEPS.length - 1); apply(); });
    smaller.addEventListener("click", () => { level = Math.max(level - 1, 0); apply(); });
    apply();
  </script>

  <script>
    const box = document.getElementById("lightbox")!;
    const frame = box.querySelector(".lightbox-frame") as HTMLElement;
    const big = box.querySelector("img")!;

    const close = () => {
      box.hidden = true;
      box.classList.remove("full");
      document.body.style.overflow = "";
    };

    document.querySelectorAll<HTMLImageElement>(".prose img").forEach((img) => {
      img.classList.add("zoomable");
      img.tabIndex = 0;
      const open = () => {
        big.src = img.currentSrc || img.src;
        big.alt = img.alt;
        box.hidden = false;
        document.body.style.overflow = "hidden";
      };
      img.addEventListener("click", open);
      img.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") { e.preventDefault(); open(); }
      });
    });

    big.addEventListener("click", (e) => {
      e.stopPropagation();
      box.classList.toggle("full");
      frame.scrollTo(0, 0);
    });
    box.addEventListener("click", close);
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !box.hidden) close();
    });
  </script>
</BaseLayout>
