---
import BlogLayout from "../../layouts/BlogLayout.astro";
import { getCollection } from "astro:content";

const all = await getCollection("blog", ({ data }) => !data.draft);
const posts = all.sort((a, b) => +b.data.date - +a.data.date);

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });
---
<BlogLayout
  title="Blog"
  description="Blog posts by Christopher Z. Cui."
>
  <article class="prose">
    <h1>Blog</h1>

    {posts.length === 0 ? (
      <p class="entry-excerpt"><em>Nothing pinned up yet &mdash; check back soon.</em></p>
    ) : (
      <ul class="entry-list">
        {posts.map((p) => (
          <li>
            <div class="entry-title"><a href={`/blog/${p.slug}/`}>{p.data.title}</a></div>
            <div class="entry-meta">
              {fmt(p.data.date)}
              {p.data.tags.length > 0 && <> &middot; {p.data.tags.join(", ")}</>}
            </div>
            <div class="entry-excerpt">{p.data.description}</div>
          </li>
        ))}
      </ul>
    )}
  </article>
</BlogLayout>
