---
import BlogLayout from "../../layouts/BlogLayout.astro";
import TrajectoryViewer from "../../components/TrajectoryViewer.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const { trajectories } = post.data;

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });
---
<BlogLayout title={post.data.title} description={post.data.description}>
  {trajectories && (
    <>
      <script is:inline>
        // Pick the view before paint so split/trajectory pages don't flash.
        (function () {
          var v = new URLSearchParams(location.search).get("view");
          if (v !== "split" && v !== "trajectory") v = "post";
          document.documentElement.setAttribute("data-reader-view", v);
        })();
      </script>
      <div class="view-switch" role="group" aria-label="View">
        <button type="button" data-view="post">post</button>
        <button type="button" data-view="split">split</button>
        <button type="button" data-view="trajectory">trajectories</button>
      </div>
    </>
  )}

  <div class="reader">
    <article class="prose reader-post">
      <h1>{post.data.title}</h1>
      {post.data.deck && <p class="deck">{post.data.deck}</p>}
      <div class="entry-meta">
        {fmt(post.data.date)}
        {post.data.tags.length > 0 && <> &middot; {post.data.tags.join(", ")}</>}
      </div>

      <Content />

      <hr />
      <p><a href="/blog/">&larr; all posts</a></p>
    </article>

    {trajectories && (
      <div class="reader-traj">
        <TrajectoryViewer src={trajectories} />
      </div>
    )}
  </div>
</BlogLayout>

<script>
  const html = document.documentElement;
  const viewer = document.querySelector<HTMLElement>(".traj");
  const buttons = document.querySelectorAll<HTMLButtonElement>(".view-switch button");

  const post = document.querySelector<HTMLElement>(".reader-post");

  // The block of the post at the top of the screen, so switching views keeps
  // the reader's place.
  const topBlock = () => {
    if (!post || getComputedStyle(post).display === "none") return null;
    const edge = Math.max(post.getBoundingClientRect().top, 0);
    return [...post.children].find((el) => !el.matches(".sidenotes") && el.getBoundingClientRect().bottom > edge + 1) ?? null;
  };

  const setView = (v: string) => {
    const changed = html.getAttribute("data-reader-view") !== v;
    const keep = changed ? topBlock() : null;
    html.setAttribute("data-reader-view", v);
    keep?.scrollIntoView({ block: "start" });
    buttons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.view === v)));
    const url = new URL(location.href);
    if (v === "post") url.searchParams.delete("view");
    else url.searchParams.set("view", v);
    history.replaceState(null, "", url);
    placeSidenotes();
  };

  // Footnotes as margin notes when there's room beside the post (post view
  // only); otherwise they stay at the bottom.
  const sidenotes: { ref: HTMLElement; note: HTMLElement }[] = [];
  const rail = document.createElement("div");
  rail.className = "sidenotes";
  post?.querySelectorAll<HTMLAnchorElement>("sup a[data-footnote-ref]").forEach((ref) => {
    const item = document.getElementById(decodeURIComponent(ref.hash.slice(1)));
    if (!item) return;
    const body = item.cloneNode(true) as HTMLElement;
    body.querySelectorAll("[data-footnote-backref]").forEach((b) => b.remove());
    const note = document.createElement("aside");
    note.className = "sidenote";
    note.innerHTML = `<span class="sidenote-num">${ref.textContent}</span> ${[...body.querySelectorAll("p")].map((p) => p.innerHTML).join(" ")}`;
    rail.append(note);
    sidenotes.push({ ref, note });
    ref.addEventListener("click", (e) => {
      if (!html.classList.contains("has-sidenotes")) return;
      e.preventDefault();
      note.classList.remove("flash");
      void note.offsetWidth;
      note.classList.add("flash");
    });
  });
  if (post && sidenotes.length) post.append(rail);

  function placeSidenotes() {
    if (!post || !sidenotes.length) return;
    const rem = parseFloat(getComputedStyle(html).fontSize);
    const room = document.documentElement.clientWidth - post.getBoundingClientRect().right;
    const fits = (html.getAttribute("data-reader-view") ?? "post") === "post" && room >= 17.5 * rem;
    html.classList.toggle("has-sidenotes", fits);
    if (!fits) return;
    const top = post.getBoundingClientRect().top;
    let floor = 0;
    for (const { ref, note } of sidenotes) {
      const y = Math.max(ref.getBoundingClientRect().top - top - 0.3 * rem, floor);
      note.style.top = `${y}px`;
      floor = y + note.offsetHeight + 0.8 * rem;
    }
  }
  placeSidenotes();
  window.addEventListener("resize", placeSidenotes);
  if (post) new ResizeObserver(placeSidenotes).observe(post);
  document.fonts?.ready.then(placeSidenotes);

  // "cite this post" copy button.
  document.querySelectorAll<HTMLButtonElement>("[data-copy-cite]").forEach((b) => {
    b.addEventListener("click", async () => {
      const text = b.closest(".cite")?.querySelector("pre")?.textContent ?? "";
      try {
        await navigator.clipboard.writeText(text);
        b.textContent = "copied";
      } catch {
        b.textContent = "select & copy";
      }
      setTimeout(() => (b.textContent = "copy"), 1600);
    });
  });

  if (viewer) {
    buttons.forEach((b) => b.addEventListener("click", () => setView(b.dataset.view!)));
    setView(html.getAttribute("data-reader-view") || "post");

    // Links like #trajectory-zork-202411061-1 (game optional) open that step
    // in the viewer, switching to split view if only the post is showing.
    const goto = (hash: string) => {
      const m = hash.match(/^#trajectory-(?:([a-z][\w-]*?)-)?(\d+)-(\d+)$/);
      if (!m) return false;
      if (html.getAttribute("data-reader-view") === "post") setView("split");
      viewer.dispatchEvent(new CustomEvent("traj:goto", { detail: { game: m[1], seed: m[2], step: +m[3] } }));
      return true;
    };
    document.querySelectorAll<HTMLAnchorElement>('.reader-post a[href^="#trajectory-"]').forEach((a) => {
      a.classList.add("traj-link");
      a.addEventListener("click", (e) => { if (goto(a.getAttribute("href")!)) e.preventDefault(); });
    });
    document.querySelectorAll<HTMLAnchorElement>("a[data-view-link]").forEach((a) => {
      a.addEventListener("click", (e) => { e.preventDefault(); setView(a.dataset.viewLink!); });
    });
    if (location.hash) viewer.addEventListener("traj:ready", () => goto(location.hash), { once: true });
    window.addEventListener("hashchange", () => goto(location.hash));
  }
</script>
